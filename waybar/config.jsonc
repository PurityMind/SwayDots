{
  "layer": "top",
  "position": "top",
  "height": 32,
  "modules-left": ["sway/workspaces", "custom/music" ],

  "modules-center": ["clock"],

  "modules-right": [
    "pulseaudio",
    "backlight",
    "network",
    "cpu",
    "memory",
    "tray",
    "sway/language",
    "custom/power"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
    "format-icons": {
        "urgent": "",
        "default": ""
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },
  
  "backlight": {
      "format": "{percent}% {icon}",
      "format-icons": ["", ""]
  },

  "custom/music": {
    "format": "{icon} {text}",
    "return-type": "json",
    "format-icons": {
        "playing": "▶",
        "paused": "⏸"
    },
    "escape": true,
    "exec": "playerctl metadata --format '{\"text\": \"{{ artist }} - {{ title }}\", \"alt\": \"{{ status }}\", \"class\": \"{{ status }}\"}' 2>/dev/null || echo '{\"text\": \"\", \"class\": \"stopped\"}'",
    "exec-if": "playerctl status 2>/dev/null",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "max-length": 50,
    "tooltip": false
  },

  "clock": {
    "timezone": "Europe/Moscow",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d/%m/%Y - %H:%M:%S}",
    "interval": 1
  },

  "network": {
    "format-wifi": "󰤢 {bandwidthDownBits}",
    "format-ethernet": "󰈀 {bandwidthDownBits}",
    "format-disconnected": "󰤠 No Network",
    "interval": 5,
    "tooltip": false
  },

  "cpu": {
    "interval": 1,
    "format": "  {icon} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout &",
    "format": "⏻"
  },

  "sway/language": {
    "format": "{}",
    "min-length": 5,
    "tooltip": false
  }
}
